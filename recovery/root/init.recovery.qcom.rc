on early-fs
    write /proc/sys/kernel/sched_lib_name "recovery,magiskboot,Updater,updater"
    write /proc/sys/kernel/sched_lib_mask_force 255

on fs
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/f0_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/osc_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/3-005a/osc_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/3-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/3-005a/custom_wave
    chmod 0666 /sys/class/qcom-haptics/lra_calibration
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/0-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/0-005a/custom_wave
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    insmod /vendor/lib/modules/exfat_miui.ko
    install_keyring

# qseecomd must start only AFTER the UFS RPMB sg nodes exist (decrypt-stall
# prevention, occurrence 5): its librpmb acquires /dev/sg* ONCE at startup and
# never recovers if the scan finds nothing, and on some boots ueventd coldboot
# hasn't created the nodes yet. The first Weaver verify then livelocks in both
# the gatekeeper HAL (userspace retry, ~85 % CPU) and qseecomd's RPMB thread
# (~2.5k "invalid RPMB device" errors/s), with every SMC completing normally —
# so no kernel bound can catch it. Trigger tricks alone do NOT work: `on boot`
# fires ~2 s in this recovery, 36 ms after the old `on init` start (proven on
# R12.0_7: sg scan at t=2.054 s vs 2.018 s before). So gate on readiness with
# a bounded poll instead. qseecomd is started through start_qseecomd.sh, which
# runs the poll as this service (user root) and then execs qseecomd; the timeout
# falls through to the start (today's behavior, never worse, never hangs boot). Keymaster/gatekeeper follow
# automatically via vendor.sys.listeners.registered. Nothing consumes TEE
# earlier than decrypt, which is minutes out.
on boot
    start vendor.qseecomd

on boot
    start health-hal-2-1
    start vendor.qti.vibrator
    setprop sys.usb.config adb

on property:vendor.sys.listeners.registered=true
    start keymaster-4-0
    start gatekeeper-1-0

# Official-parity with the miatoll OF tree: release the TEE sessions once all
# users are decrypted. Nothing in recovery needs qseecomd/gatekeeper/keymaster
# after /data is unlocked, so stop them to leave the secure world clean.
# (Not a fix for the intermittent qseecom decrypt hang - that wedges during
#  verify(), before this point - but avoids leaving TEE clients running.)
on property:twrp.all.users.decrypted=true
    setprop crypto.ready 0
    stop vendor.qseecomd
    stop gatekeeper-1-0
    stop keymaster-4-0

service vendor.qseecomd /system/bin/start_qseecomd.sh
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service-qti
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# Vibrator HAL, source-built from vendor/qcom/opensource/vibrator
# (binary staged by BOARD_RECOVERY_IMAGE_PREPARE)
service vendor.qti.vibrator /vendor/bin/hw/vendor.qti.hardware.vibrator.service
    class hal
    user system
    group system input
    seclabel u:r:recovery:s0
